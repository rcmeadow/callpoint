# TypeSafe API key (bring your own). Leave empty to use the macOS Keychain item
# named TYPESAFE_API_KEY instead, or to run in Replay mode only.
TYPESAFE_API_KEY=

# Jev model, pinned so runs are comparable. Do not use jev-latest for recordings.
JEV_MODEL=jev-1.13.0

# Local engine (Ollama). clef = Cloudflare Clef via Ollama's /v1/systemone (needs Ollama 0.35.1+).
# llm = the older llama3.2 chat adapter (one-hot answers, no probabilities).
LOCAL_ENGINE=clef
OLLAMA_URL=http://localhost:11434
# Default depends on LOCAL_ENGINE: clef-flash:9b for clef, llama3.2:3b for llm.
LOCAL_MODEL=
# Only used by LOCAL_ENGINE=llm (one request per question).
LOCAL_CONCURRENCY=4

# Server port (Vite proxies /api to it)
PORT=8787
